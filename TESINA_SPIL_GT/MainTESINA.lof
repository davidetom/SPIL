\contentsline {figure}{\numberline {2.1}{\ignorespaces Schema generale della procedura risolutiva: esplorazione a griglia della frequenza $X_r$, con costruzione delle rotte affidata, alternativamente, all'euristica Greedy o all'euristica Clarke-Wright.}}{13}{figure.2.1}%
\addvspace {10pt}
\contentsline {figure}{\numberline {3.1}{\ignorespaces Benchmark 1: gap su $F_{\mathrm {tot}}$ tra Greedy e Clarke-Wright al variare di $N$ per le tre politiche (media su 30 seed).}}{43}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Benchmark 1: gap logistico tra Greedy e CW (fisso, viaggio e lavoro) a frequenza $X_r$ comune, calcolato per rifiuto e mediato sui rifiuti e sui 30 seed, per quattro valori di $N$ (fasce IC95).}}{44}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Benchmark 1 ($N=1000$): soluzione selezionata al variare di $\gamma $ (media su 30 seed, fasce IC95): camion per giro, attivazioni settimanali, chilometri, ore di lavoro, disservizio grezzo e frequenze ottime $X^*_r$ per rifiuto (CW continuo, Greedy tratteggiato).}}{45}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Benchmark 2: gap su $F_{\mathrm {tot}}$ tra Greedy e Clarke-Wright per scenario urbanistico e politica (media su 30 seed, barre: IC95).}}{49}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Camion per giro dell'organico in funzione della frequenza $X_r$ (media su 30 seed, fasce IC95): $B1$ con $N=1000$, grandi condomini e villette con $N=400$. La linea tratteggiata è $V\cdot X$ costante, ancorata al valore di Greedy a $X_r=0.5$.}}{50}{figure.3.5}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Benchmark 3: gap logistico tra Greedy e CW a frequenza $X_r$ comune, per distribuzione uniforme e aggregata ($N=400$, media su 30 seed, fasce IC95).}}{54}{figure.3.6}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Benchmark 4: soluzioni distinte (punti) e intervalli di $\gamma $ per cui sono ottime. Asse $x$: costo logistico grezzo settimanale; asse $y$: disservizio grezzo.}}{59}{figure.3.7}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Benchmark 4: grandezze fisiche e frequenze ottime al variare di $\gamma $ (Greedy in blu e CW in arancione; nel pannello delle frequenze CW a linea continua e Greedy tratteggiato dove le due curve differiscono).}}{59}{figure.3.8}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Gap logistico tra Greedy e CW a frequenza $X_r$ comune con $N=1000$: sintetico originale ($A=100$\,km$^2$), sintetico con area e mix di Fabriano (B1S) e sottocampioni di utenti reali di Fabriano (B4sub) (media su 30 seed, fasce IC95).}}{61}{figure.3.9}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Gap su $F_{\mathrm {tot}}$ in funzione di $N$ per $\gamma =0.1,\,0.5,\,0.9$: sintetico originale, sintetico con area e mix di Fabriano, utenti reali campionati (barre: IC95 sui 30 seed); la stella indica Fabriano con tutti gli utenti ($N=3932$).}}{64}{figure.3.10}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Benchmark 5 ($N=200$): soluzione selezionata al variare di $\gamma $ (media su 30 seed, fasce IC95); stessi pannelli della Figura~\ref {fig:b1_fisica}.}}{70}{figure.3.11}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Scomposizione del gap su $F_{\mathrm {tot}}$ (punti percentuali, media su 30 seed) in routing a pari frequenza e spostamento di $X^*$, per le tre politiche: Benchmark 1 al variare di $N$, Benchmark 2 per scenario, Benchmark 5.}}{71}{figure.3.12}%
\contentsline {figure}{\numberline {3.13}{\ignorespaces Frontiere normalizzate su sei istanze: costo logistico e disservizio di ogni soluzione divisi per quelli di Greedy a $\gamma =0.05$ (media sui seed; un punto per valore di $\gamma $). Greedy tratteggiato, CW continuo; le etichette indicano la soluzione di CW a $\gamma =0.10$, $0.50$ e $0.90$.}}{76}{figure.3.13}%
\contentsline {figure}{\numberline {3.14}{\ignorespaces Fabriano, istanza completa, CW: saturazione temporale e fisica in funzione di $X_r$ per rifiuto. La linea punteggiata è la soglia prevista dalla~\eqref {eq:t2_soglia}; nel titolo, la frequenza da cui il numero di camion per giro resta costante.}}{79}{figure.3.14}%
\contentsline {figure}{\numberline {3.15}{\ignorespaces CW rispetto a Greedy a pari $X_r$ (somma sui rifiuti, media sui seed): vantaggio logistico, cioè costo di Greedy diviso costo di CW meno uno, e variazione percentuale dei camion per giro. Linea: mediana sulle 23 istanze; fascia: minimo e massimo.}}{82}{figure.3.15}%
