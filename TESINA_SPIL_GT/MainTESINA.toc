\contentsline {chapter}{Conclusioni e sviluppi futuri}{89}{chapter*.50}%
\contentsline {paragraph}{La scelta di $\gamma $ è una scelta tra poche soluzioni, ciascuna con un prezzo.}{89}{section*.51}%
\contentsline {paragraph}{Il disservizio ha un minimo strutturale e la flotta ha due regimi.}{89}{section*.52}%
\contentsline {paragraph}{Clarke-Wright domina Greedy a parità di disservizio, non a parità di $\gamma $.}{90}{section*.53}%
\contentsline {paragraph}{Il vantaggio di CW dipende dal peso del viaggio, non dalla rete.}{90}{section*.54}%
\contentsline {paragraph}{La ricerca sulle frequenze può essere potata senza perdere l'ottimo.}{91}{section*.55}%
